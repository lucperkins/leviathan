---
import config from "../../site.config";

interface Props {
  number: number;
  title: string;
  /** Absent for front matter (number ≤ 0) and back matter, which get no unit number. */
  part?: string;
}
const { number, title, part } = Astro.props;
const { unitWord, frontMatterLabel, backMatterLabel } = config.text;
const eyebrow = part ? `${unitWord} ${number}` : number <= 0 ? frontMatterLabel : backMatterLabel;
---

<header class="mb-8">
  <p class="eyebrow">
    {eyebrow}
  </p>
  <h1 class="mt-1 font-serif text-3xl font-semibold">{title}</h1>
</header>
