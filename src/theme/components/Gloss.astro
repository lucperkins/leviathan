---
/**
 * A short explanatory note attached to a word in prose, for historical detail
 * that is not one of the text's defined terms and so has no page of its own.
 *
 * The concept tooltips in chapter text are generated by rehype-concepts from
 * the concept and touchstone collections; this is the hand-written case, for
 * use inside MDX:
 *
 *   <Gloss note="A battle in June 1645…">Naseby</Gloss>
 *
 * Hover or focus shows the note. No JavaScript: the term is a button so it can
 * be reached from the keyboard, and the note is shown on :focus-within.
 */
interface Props {
  note: string;
}
const { note } = Astro.props;
---

<span class="gloss">
  <button type="button" class="gloss__term"><slot /></button>
  <span class="gloss__note" role="tooltip">{note}</span>
</span>
