---
/**
 * The editorial headnote above a chapter: what the chapter is doing and where
 * it joins the rest of the book, set apart from the text itself. The mark is
 * an asterisk — the printer's sign for a note — drawn in the sidebar icons'
 * idiom.
 */
import { inlineMarkdown } from "../lib/inline";

interface Props {
  /** Inline markdown, so links work. */
  note: string;
}
const { note } = Astro.props;
---

<aside class="chapter-note">
  <svg
    class="chapter-note__mark"
    aria-hidden="true"
    viewBox="0 0 16 16"
    width="14"
    height="14"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
  >
    <path d="M8 4.2v7.6M4.7 6.1l6.6 3.8M11.3 6.1 4.7 9.9" />
  </svg>
  <p set:html={inlineMarkdown(note)} />
</aside>
