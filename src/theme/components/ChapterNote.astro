---
/**
 * The editorial headnote above a chapter: what the chapter is doing and where
 * it joins the rest of the book, set apart from the text itself. The mark is
 * a quill — the editor's hand — drawn in the sidebar icons' idiom.
 */
import { inlineMarkdown } from "../lib/inline";

interface Props {
  /** Inline markdown, so links work. */
  note: string;
}
const { note } = Astro.props;
---

<aside class="chapter-note">
  <svg
    class="chapter-note__mark"
    aria-hidden="true"
    viewBox="0 0 16 16"
    width="15"
    height="15"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
  >
    <path d="M2.8 13.2C3.6 8 7 3.8 13.6 2.4M13.6 2.4C13.2 8.2 9.8 11.9 4 12.9M5.4 10.6 2.2 13.8" />
  </svg>
  <p set:html={inlineMarkdown(note)} />
</aside>
