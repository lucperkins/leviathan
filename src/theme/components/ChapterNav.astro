---
import config from "../../site.config";
import { divisionLabel, divisionNumber } from "../lib/divisions";
import ChapterNavItem from "./ChapterNavItem.astro";
import NavSection from "./NavSection.astro";

export interface NavChapter {
  id: string;
  number: number;
  title: string;
  /** Absent for front matter (number ≤ 0, listed before the divisions) and back matter (listed after). */
  part?: string;
}

interface Props {
  chapters: NavChapter[];
  currentPath?: string;
}
const { chapters, currentPath } = Astro.props;
const { basePath, navId, navTitle, contents, divisions } = config.text;

const sorted = [...chapters].sort((a, b) => a.number - b.number);
const front = sorted.filter((ch) => !ch.part && ch.number <= 0);
const back = sorted.filter((ch) => !ch.part && ch.number > 0);
const parts = new Map<string, NavChapter[]>();
for (const ch of sorted) {
  if (ch.part) parts.set(ch.part, [...(parts.get(ch.part) ?? []), ch]);
}
// Divisions in the book's order, not first-seen order.
const ordered = [...parts].sort(([a], [b]) => divisionNumber(divisions, a) - divisionNumber(divisions, b));
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const isActive = (ch: NavChapter) => currentPath === `${basePath}/${ch.id}/`;
---

<nav aria-label={navTitle} class="text-sm">
  <NavSection id={navId} title={navTitle}>
    {
      contents && (
        <ul class="mb-2 ml-2 space-y-1">
          <ChapterNavItem
            chapter={{ id: "contents", number: 0, title: contents.title }}
            href={contents.href}
            active={currentPath === contents.href}
          />
        </ul>
      )
    }
    {
      front.length > 0 && (
        <ul class="mb-2 ml-2 space-y-1">
          {front.map((ch) => (
            <ChapterNavItem chapter={ch} active={isActive(ch)} />
          ))}
        </ul>
      )
    }
    {
      ordered.map(([part, list]) => (
        <NavSection id={`part-${slug(part)}`} title={divisionLabel(divisions, part)} nested>
          <ul class="space-y-1">
            {list.map((ch) => (
              <ChapterNavItem chapter={ch} active={isActive(ch)} />
            ))}
          </ul>
        </NavSection>
      ))
    }
    {
      back.length > 0 && (
        <ul class="mt-2 ml-2 space-y-1">
          {back.map((ch) => (
            <ChapterNavItem chapter={ch} active={isActive(ch)} />
          ))}
        </ul>
      )
    }
  </NavSection>
</nav>
