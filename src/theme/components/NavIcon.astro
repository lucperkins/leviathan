---
/**
 * The small mark beside a top-level sidebar section. Keyed by the section's
 * id into the site config's `icons`, so NavSection can look one up without
 * every call site passing it; the nested division sections inside the book
 * get none. It takes its colour from whatever it sits in, so the mark and the
 * label beside it always match.
 */
import config from "../../site.config";

interface Props {
  name: string;
}
const { name } = Astro.props;

/** Paths for a 16×16 box, stroked rather than filled. */
const paths = config.icons[name];
---

{
  paths && (
    <svg
      aria-hidden="true"
      viewBox="0 0 16 16"
      width="14"
      height="14"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="shrink-0"
    >
      {paths.map((d) => (
        <path d={d} />
      ))}
    </svg>
  )
}
