---
/**
 * Cycles light → sepia → dark. State lives in the Alpine `theme` store, so the
 * sidebar toggle and the mobile navbar toggle agree, and is persisted; Layout.astro applies it before paint. The icon shown is the
 * one you get by clicking, as it was when this was a two-way switch: a page
 * for sepia, a moon for dark, a sun for light.
 */
---

<button
  type="button"
  x-on:click="$store.theme.cycle()"
  x-bind:aria-label="'Switch to ' + $store.theme.label.toLowerCase()"
  x-bind:title="$store.theme.label"
  class="inline-flex items-center justify-center rounded p-1.5 -ml-1.5 text-stone-500 transition-colors hover:bg-stone-200 hover:text-stone-800 dark:text-stone-400 dark:hover:bg-stone-800 dark:hover:text-stone-100"
>
  <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    {/* Sepia: a page with lines on it. */}
    <g x-show="$store.theme.next === 'sepia'" x-cloak>
      <path d="M3.5 2.5h9v11h-9z" />
      <path d="M5.5 5.5h5M5.5 8h5M5.5 10.5h3" />
    </g>
    {/* Dark: a moon. */}
    <g x-show="$store.theme.next === 'dark'" x-cloak>
      <path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7Z" />
    </g>
    {/* Light: a sun. */}
    <g x-show="$store.theme.next === 'light'" x-cloak>
      <circle cx="8" cy="8" r="3" />
      <path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1 1M11.6 11.6l1 1M3.4 12.6l1-1M11.6 4.4l1-1" />
    </g>
  </svg>
</button>
