---
/**
 * An image that opens in a dismissable modal (native <dialog>, driven by the
 * Alpine `lightbox` component): click to open; Escape, the close button in
 * the top-right corner of the screen, or a click anywhere but the image
 * itself closes it.
 * The enlarged image is capped at two thirds of the viewport height, with
 * the caption centred beneath it.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Shown under the enlarged image. */
  caption?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  /** Above the fold: fetch immediately instead of lazily. */
  priority?: boolean;
  /** Sharp's webp quality. The default is tuned for engravings, which are fine line work and compress badly. */
  quality?: number;
}
const {
  src,
  alt,
  caption,
  widths = [480, 720, 1080],
  sizes = "(min-width: 1024px) 42rem, 100vw",
  class: className,
  priority = false,
  quality = 68,
} = Astro.props;
---

<div x-data="lightbox">
  <button type="button" x-on:click="open()" class="block w-full cursor-zoom-in" title="View full size">
    <Image
      src={src}
      width={Math.max(...widths)}
      widths={widths}
      sizes={sizes}
      quality={quality}
      alt={alt}
      class={className}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
    />
  </button>
  <dialog
    x-ref="dialog"
    x-on:click="if (!$event.target.closest('img, button')) close()"
    x-on:close="closed()"
    class="lightbox m-auto max-w-[calc(100vw-3rem)] bg-transparent p-0 backdrop:bg-stone-950/85"
    aria-label={alt}
  >
    <figure class="m-0 flex flex-col items-center gap-4">
      {/* alt is empty on purpose: the dialog carries the description in its
          aria-label, and a real alt here renders as a wall of text in the
          middle of the screen while the full-size file loads. */}
      <Image
        src={src}
        width={1200}
        quality={quality}
        alt=""
        loading="lazy"
        decoding="async"
        class="block max-h-[66vh] max-w-full rounded object-contain"
      />
      {caption && <figcaption class="max-w-prose text-center text-sm leading-relaxed text-stone-300">{caption}</figcaption>}
    </figure>
    <button
      type="button"
      x-on:click="close()"
      aria-label="Close"
      class="fixed top-4 right-4 rounded-full bg-stone-950/70 p-2.5 text-stone-100 transition-colors hover:bg-stone-800"
    >
      <svg aria-hidden="true" viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 4l8 8M12 4l-8 8" /></svg>
    </button>
  </dialog>
</div>
