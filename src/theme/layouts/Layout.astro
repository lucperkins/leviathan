---
import "../../styles/global.css";
import { getCollection } from "astro:content";
import config from "../../site.config";
import BackButton from "../components/BackButton.astro";
import ChapterNav from "../components/ChapterNav.astro";
import ListNav from "../components/ListNav.astro";
import Navbar from "../components/Navbar.astro";
import SiteTitle from "../components/SiteTitle.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title: string;
}
const { title } = Astro.props;

const isHome = Astro.url.pathname === "/";
const currentPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

/** Collection names come from the site config as strings, so the generated key types can't narrow them. */
const collect = async (name: string) =>
  (await getCollection(name as never)) as unknown as { id: string; data: Record<string, any> }[];
const chapters = (await collect(config.text.collection)).map((ch) => ({
  id: ch.id,
  ...(ch.data as { number: number; title: string; part?: string }),
}));
const sections = await Promise.all(
  config.sections.map(async (s) => ({
    ...s,
    items: (await collect(s.collection)).map(s.item),
  })),
);
---

<html lang={config.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {config.robots && <meta name="robots" content={config.robots} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title} · {config.title}</title>
    {/* Pre-paint: apply the persisted theme (or system preference) so there is no flash. Alpine `theme` owns it after boot. */}
    <script is:inline define:vars={{ themeKey: `${config.storagePrefix}:theme` }}>
      (() => {
        let stored = null;
        try {
          stored = JSON.parse(localStorage.getItem(themeKey) || "null");
        } catch {}
        const mode = stored ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.classList.toggle("dark", mode === "dark");
        document.documentElement.classList.toggle("theme-sepia", mode === "sepia");
      })();
    </script>
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-900 dark:bg-stone-950 dark:text-stone-100">
    {/* Below desk the window is a column — navbar, then the page scrolling in its
        own box — so the scrollbar runs under the navbar rather than behind it.
        Above desk the document scrolls and the sidebar sticks beside it. */}
    <div class="flex h-dvh flex-col desk:h-auto desk:min-h-screen desk:flex-row" x-data x-on:keydown.escape.window="$store.drawer.close()">
      <Navbar class="shrink-0 desk:hidden" />

      {/* The scrim behind the open drawer. */}
      <div
        x-show="$store.drawer.open"
        x-on:click="$store.drawer.close()"
        x-cloak
        class="fixed inset-0 z-30 bg-stone-950/40 desk:hidden"
        aria-hidden="true"
      >
      </div>

      <aside
        id="site-nav"
        x-bind:class="$store.drawer.open && 'is-open'"
        class="site-chrome nav-drawer fixed inset-y-0 left-0 z-40 flex h-screen w-80 max-w-[85vw] shrink-0 flex-col border-r border-stone-200 transition-transform duration-200 desk:sticky desk:top-0 desk:w-64 desk:max-w-none xl:w-80 dark:border-stone-800"
      >
        {/* The masthead stays put while the list below it scrolls. px-6 lines it up
            with the nav link text, which sits in the scroll box's pl-3 plus its own px-3. */}
        <div class="shrink-0 border-b border-stone-200 px-6 pt-6 pb-4 dark:border-stone-800"><SiteTitle /></div>
        <div class="flex-1 overflow-y-auto pt-3 pr-2 pb-6 pl-3" data-nav-scroll x-data="navScroll" x-on:scroll.passive="save()">
          <ChapterNav chapters={chapters} currentPath={currentPath} />
          {/* The rule splits the book section's bottom margin so the gap to the first section equals the gaps below it. */}
          <div class="-mt-2 border-t border-stone-200 pt-2 dark:border-stone-800">
            {
              sections.map((s) => (
                <ListNav
                  sectionId={s.id}
                  title={s.title}
                  basePath={s.basePath}
                  items={s.items}
                  currentPath={currentPath}
                  indexHref={`${s.basePath}/`}
                  indexTitle="Overview"
                />
              ))
            }
            {
              config.apparatus && (
                <ListNav
                  sectionId={config.apparatus.id}
                  title={config.apparatus.title}
                  basePath=""
                  items={config.apparatus.items}
                  currentPath={currentPath}
                  indexHref={config.apparatus.indexHref}
                  indexTitle="Overview"
                />
              )
            }
          </div>
        </div>
        <div class="hidden border-t border-stone-200 px-4 py-3 desk:block dark:border-stone-800">
          <ThemeToggle />
        </div>

        {/* Pre-paint only: apply the accordion state Alpine's $persist stored, then the sidebar's
            last scroll offset, so neither jumps after load. Alpine owns both after boot. */}
        <script is:inline define:vars={{ prefix: config.storagePrefix }}>
          for (const el of document.querySelectorAll("details[data-nav-section]")) {
            // The section holding the current page is always open. Doing it here
            // rather than leaving it to Alpine matters: sections now render
            // closed, so if this one were still shut when the scroll offset is
            // restored below the nav would be too short and the browser would
            // clamp it, losing the reader's place.
            if (el.querySelector('[aria-current="page"]')) {
              el.open = true;
              continue;
            }
            try {
              const v = localStorage.getItem(`${prefix}:nav:${el.dataset.navSection}`);
              if (v !== null) el.open = JSON.parse(v);
            } catch {}
          }
          try {
            const nav = document.querySelector("[data-nav-scroll]");
            const y = Number(sessionStorage.getItem(`${prefix}:nav-scroll`));
            if (nav && y > 0) nav.scrollTop = y;
          } catch {}
        </script>
      </aside>
      {/* @container lets .breakout measure the room around the column in cqw
          and spill into it symmetrically. */}
      <main class="@container min-h-0 min-w-0 flex-1 overflow-y-auto px-5 pt-8 pb-24 md:px-8 desk:overflow-visible desk:px-12 desk:pt-12 desk:pb-32">
        <div class="mx-auto max-w-2xl">
          {!isHome && <BackButton />}
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
