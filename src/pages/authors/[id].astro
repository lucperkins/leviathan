---
import { getCollection, getEntries, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ConceptHeader from "../../components/ConceptHeader.astro";
import PrevNext from "../../components/PrevNext.astro";
import Prose from "../../components/Prose.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import { chapterLinks } from "../../lib/related";
import { neighbours } from "../../lib/sequence";

export async function getStaticPaths() {
  // Same order as the sidebar: alphabetical by title.
  const authors = (await getCollection("authors")).sort((a, b) => a.data.title.localeCompare(b.data.title));
  return authors.map((author, i) => ({
    params: { id: author.id },
    props: {
      author,
      ...neighbours(authors, i, (a) => ({ href: `/authors/${a.id}/`, title: a.data.title })),
    },
  }));
}

const { author, prev, next } = Astro.props;
const { Content } = await render(author);
const chapters = chapterLinks(await getEntries(author.data.chapters));
---

<Layout title={author.data.title}>
  <ConceptHeader kind="Author" title={author.data.title} meta={author.data.dates} summary={author.data.summary} />
  <Prose>
    <Content />
  </Prose>
  <RelatedLinks title="Read in Leviathan" items={chapters} />
  <PrevNext kind="author" prev={prev} next={next} />
</Layout>
