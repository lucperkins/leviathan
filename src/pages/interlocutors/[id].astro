---
import { getCollection, getEntries, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ConceptHeader from "../../components/ConceptHeader.astro";
import PrevNext from "../../components/PrevNext.astro";
import Prose from "../../components/Prose.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import { chapterLinks, sortInterlocutors } from "../../lib/related";
import { neighbours } from "../../lib/sequence";

export async function getStaticPaths() {
  // Same order as the sidebar: by surname.
  const interlocutors = sortInterlocutors(await getCollection("interlocutors"));
  return interlocutors.map((interlocutor, i) => ({
    params: { id: interlocutor.id },
    props: {
      interlocutor,
      ...neighbours(interlocutors, i, (a) => ({ href: `/interlocutors/${a.id}/`, title: a.data.title })),
    },
  }));
}

const { interlocutor, prev, next } = Astro.props;
const { Content } = await render(interlocutor);
const chapters = chapterLinks(await getEntries(interlocutor.data.chapters));
---

<Layout title={interlocutor.data.title}>
  <ConceptHeader kind="Interlocutor" title={interlocutor.data.title} meta={interlocutor.data.dates} summary={interlocutor.data.summary} />
  <Prose>
    <Content />
  </Prose>
  <RelatedLinks title="Read in Leviathan" items={chapters} />
  <PrevNext kind="interlocutor" prev={prev} next={next} />
</Layout>
