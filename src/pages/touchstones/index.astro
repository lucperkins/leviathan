---
import { getCollection } from "astro:content";
import IndexPage from "../../theme/components/IndexPage.astro";
import { sortTouchstones } from "../../lib/related";

const people = sortTouchstones(await getCollection("touchstones"));
const entries = people.map((p) => ({
  href: `/touchstones/${p.id}/`,
  title: p.data.title,
  meta: p.data.dates,
  summary: p.data.summary,
}));
---

<IndexPage
  title="Touchstones"
  intro="The thinkers whose arguments the book takes on, at enough length to be worth an essay. Not all of them are named in it: Aquinas never is, though most of what Hobbes attacks as scholasticism is his. For everyone Hobbes does name, however briefly, see [Thinkers named](/thinkers/)."
  entries={entries}
/>
