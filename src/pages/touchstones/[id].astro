---
import { getCollection, getEntries } from "astro:content";
import EntryPage from "../../theme/components/EntryPage.astro";
import { entryRoutes } from "../../theme/lib/routes";
import { chapterLinks, sortTouchstones } from "../../lib/related";

export async function getStaticPaths() {
  // Same order as the sidebar: by surname.
  return entryRoutes(sortTouchstones(await getCollection("touchstones")), "/touchstones");
}

const { entry, prev, next } = Astro.props;
const chapters = chapterLinks(await getEntries(entry.data.chapters));
---

<EntryPage
  entry={entry}
  kind="Touchstone"
  meta={entry.data.dates}
  related={[{ title: "Read in Leviathan", items: chapters }]}
  prev={prev}
  next={next}
  sequence="touchstone"
/>
