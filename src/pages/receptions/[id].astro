---
import { getCollection, getEntries, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ConceptHeader from "../../components/ConceptHeader.astro";
import PrevNext from "../../components/PrevNext.astro";
import Prose from "../../components/Prose.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import { chapterLinks, conceptLinks, themeLinks } from "../../lib/related";
import { neighbours } from "../../lib/sequence";

export async function getStaticPaths() {
  // Alphabetical, like the sidebar and the readings.
  const receptions = (await getCollection("receptions")).sort((a, b) => a.data.title.localeCompare(b.data.title));
  return receptions.map((reception, i) => ({
    params: { id: reception.id },
    props: {
      reception,
      ...neighbours(receptions, i, (w) => ({ href: `/receptions/${w.id}/`, title: w.data.title })),
    },
  }));
}

const { reception, prev, next } = Astro.props;
const { Content } = await render(reception);
const chapters = chapterLinks(await getEntries(reception.data.chapters));
const concepts = conceptLinks(await getEntries(reception.data.concepts));
const themes = themeLinks(await getEntries(reception.data.themes));
---

<Layout title={reception.data.title}>
  <ConceptHeader kind="Reception" title={reception.data.title} summary={reception.data.summary} />
  <Prose>
    <Content />
  </Prose>
  <RelatedLinks title="Related themes" items={themes} />
  <RelatedLinks title="Related concepts" items={concepts} />
  <RelatedLinks title="Read in Leviathan" items={chapters} />
  <PrevNext kind="reception" prev={prev} next={next} />
</Layout>
