---
import { getCollection, getEntries } from "astro:content";
import EntryPage from "../../theme/components/EntryPage.astro";
import { entryRoutes } from "../../theme/lib/routes";
import { chapterLinks, conceptLinks, contextLinks, themeLinks } from "../../lib/related";

export async function getStaticPaths() {
  // Alphabetical, like the sidebar and the readings.
  const receptions = (await getCollection("receptions")).sort((a, b) => a.data.title.localeCompare(b.data.title));
  return entryRoutes(receptions, "/receptions");
}

const { entry, prev, next } = Astro.props;
const chapters = chapterLinks(await getEntries(entry.data.chapters));
const concepts = conceptLinks(await getEntries(entry.data.concepts));
const themes = themeLinks(await getEntries(entry.data.themes));
const context = contextLinks(await getEntries(entry.data.context));
---

<EntryPage
  entry={entry}
  kind="Reception"
  related={[
    { title: "Related themes", items: themes },
    { title: "Related context", items: context },
    { title: "Related concepts", items: concepts },
    { title: "Read in Leviathan", items: chapters },
  ]}
  prev={prev}
  next={next}
  sequence="reception"
/>
