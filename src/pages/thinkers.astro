---
import Layout from "../layouts/Layout.astro";
// @ts-ignore -- plain-JS helpers, so the links use the site's paragraph numbering
import { loadChapters, locate, quoteHref } from "../plugins/rehype-quote-sources.mjs";
// @ts-ignore
import { CATEGORIES, OMISSIONS } from "../lib/thinkers.mjs";
// @ts-ignore
import { rawMentions } from "../lib/mentions.mjs";

const chapters = loadChapters();
const unresolved: string[] = [];

/** Link to the paragraph where Hobbes names the person, falling back to the chapter. */
function passage(p: any) {
  const plain = `/chapters/${p.chapter}/`;
  if (!p.quote) return plain;
  const hit = locate(chapters, p.quote);
  if (!hit || hit.chapter.id !== p.chapter) {
    unresolved.push(`${p.name} (not found in ${p.chapter})`);
    return plain;
  }
  return quoteHref(hit.chapter.id, hit.para, p.quote);
}

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

const total = CATEGORIES.reduce((n: number, c: any) => n + c.people.length, 0);
if (unresolved.length) console.warn(`[thinkers] unresolved: ${unresolved.join(", ")}`);

/**
 * The counts are hand-verified in context, so they cannot simply be generated:
 * three of the four "Thomas"es are Becket, the apostle, and Hobbes himself.
 * What can be checked is that they still add up. Every entry must satisfy
 * `mentions + excluded === occurrences in the text`, so editing a chapter that
 * names someone fails loudly here instead of quietly making the number a lie.
 */
const miscounted = CATEGORIES.flatMap((c: any) => c.people)
  .map((p: any) => ({ p, raw: rawMentions(p.tokens) }))
  .filter(({ p, raw }: any) => raw !== p.mentions + (p.excluded ?? 0))
  .map(({ p, raw }: any) => `${p.name}: says ${p.mentions}${p.excluded ? ` + ${p.excluded} excluded` : ""}, text has ${raw}`);
if (miscounted.length) console.warn(`[thinkers] mention counts out of date — ${miscounted.join("; ")}`);
---

<Layout title="Thinkers named">
  <header class="mb-8">
    <p class="text-xs font-semibold tracking-widest text-stone-500 uppercase dark:text-stone-400">Appendix</p>
    <h1 class="mt-1 font-serif text-3xl font-semibold">Thinkers named</h1>
    <p class="mt-3 max-w-prose text-lg text-stone-600 dark:text-stone-400">
      Everyone Hobbes names as a writer or an authority: {total} people, in a book of nearly half a million words.
      He held that words are wise men's counters and the money of fools, and he cites accordingly. Each name links
      out to Wikipedia; each entry links to the passage where it appears.
    </p>
  </header>

  <nav aria-label="Sections" class="mb-10 flex items-start gap-3">
    <svg
      aria-hidden="true"
      viewBox="0 0 16 16"
      width="14"
      height="14"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      class="mt-1 shrink-0 text-stone-400 dark:text-stone-600"
    >
      <path d="M2.5 4h.01M2.5 8h.01M2.5 12h.01" />
      <path d="M6 4h7.5M6 8h7.5M6 12h5" />
    </svg>
    <ul class="space-y-1 text-sm">
      {
        CATEGORIES.map((c: any) => (
          <li>
            <a
              href={`#${slug(c.title)}`}
              class="text-stone-600 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100"
            >
              {c.title}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="#surprising-omissions"
          class="text-stone-600 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100"
        >
          Surprising omissions
        </a>
      </li>
    </ul>
  </nav>

  <div class="space-y-12">
    {
      CATEGORIES.map((c: any) => (
        <section>
          <h2
            id={slug(c.title)}
            class="section-heading"
          >
            <a href={`#${slug(c.title)}`} class="heading-anchor">
              {c.title}
            </a>
          </h2>
          <p class="mt-2 max-w-prose text-sm text-stone-500 dark:text-stone-400" set:html={c.blurb} />
          <ul class="mt-5 space-y-5">
            {c.people.map((p: any) => (
              <li class="thinker">
                <p class="thinker__head">
                  <span class="thinker__name">
                    <a class="external" href={p.wikipedia} target="_blank" rel="noopener noreferrer">
                      {p.name}
                    </a>
                  </span>
                  <span class="thinker__dates">{p.dates}</span>
                  <span class="thinker__count">
                    {p.mentions} {p.mentions === 1 ? "mention" : "mentions"}
                  </span>
                </p>
                <p class="thinker__note" set:html={p.note} />
                <p class="thinker__links">
                  <a href={passage(p)}>Chapter {parseInt(p.chapter, 10)}</a>
                  {p.touchstone && <a href={`/touchstones/${p.touchstone}/`}>Full entry</a>}
                </p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <section class="mt-16">
    <h2
      id="surprising-omissions"
      class="section-heading"
    >
      <a href="#surprising-omissions" class="heading-anchor">Surprising omissions</a>
    </h2>
    <p class="mt-4 max-w-prose font-serif text-lg leading-relaxed">
      The names below return nothing at all. Some of the absences are ordinary, but several are people Hobbes had
      read closely, worked for, argued with in print, or travelled to meet. They fit his own doctrine: an argument
      is carried by its definitions rather than by whose name is attached to it, so the moderns he does name are
      almost all people he means to take apart.
    </p>
    <ul class="mt-6 space-y-5">
      {
        OMISSIONS.map((o: any) => (
          <li class="thinker omission">
            <p class="thinker__head">
              <span class="thinker__name">
                {o.names.map(([text, href]: [string, string], i: number) => (
                  <>
                    {i > 0 && <span class="omission__and"> and </span>}
                    <a class="external" href={href} target="_blank" rel="noopener noreferrer">
                      {text}
                    </a>
                  </>
                ))}
              </span>
              <span class="thinker__count">no mentions</span>
            </p>
            <p class="thinker__note" set:html={o.why} />
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
