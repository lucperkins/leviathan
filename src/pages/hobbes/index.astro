---
import { getCollection } from "astro:content";
import IndexPage from "../../theme/components/IndexPage.astro";

const sections = (await getCollection("hobbes")).sort((a, b) => a.data.order - b.data.order);
const entries = sections.map((s) => ({
  href: `/hobbes/${s.id}/`,
  title: s.data.title,
  summary: s.data.summary,
}));
---

<IndexPage
  title="Hobbes himself"
  intro="Six short pieces on the man rather than the book: where he came from, what he did, what he was like, what he believed, who he knew, and what became of him. Read in that order. Much of what is known about the third comes from John Aubrey, who was a friend and a magpie in roughly equal measure."
  entries={entries}
/>
