---
import { getCollection } from "astro:content";
import EntryPage from "../../theme/components/EntryPage.astro";
import Lightbox from "../../theme/components/Lightbox.astro";
import { entryRoutes } from "../../theme/lib/routes";

export async function getStaticPaths() {
  // Read in sequence, not alphabetically: life, career, character, faith, contemporaries, impact.
  const sections = (await getCollection("hobbes")).sort((a, b) => a.data.order - b.data.order);
  return entryRoutes(sections, "/hobbes");
}

const { entry, prev, next } = Astro.props;
const { image, imageAlt, imageCaption, imageCredit } = entry.data;
---

<EntryPage entry={entry} kind="Hobbes himself" prev={prev} next={next} sequence="section">
  {
    image && (
      <figure class="mb-10">
        <div class="mx-auto max-w-xs">
          <Lightbox
            src={image}
            alt={imageAlt ?? entry.data.title}
            caption={imageCaption}
            widths={[320, 480, 720]}
            sizes="(min-width: 768px) 20rem, 70vw"
            class="w-full rounded border border-stone-200 shadow-[0_10px_24px_-20px_rgb(0_0_0/0.22)] dark:border-stone-800"
          />
        </div>
        {imageCredit && (
          <figcaption class="mt-3 text-center text-xs text-stone-500 dark:text-stone-400">{imageCredit}</figcaption>
        )}
      </figure>
    )
  }
</EntryPage>
