---
import Layout from "../layouts/Layout.astro";
import SectionIndex from "../components/SectionIndex.astro";

const entries = [
  {
    href: "/frontispiece/",
    title: "The frontispiece",
    summary:
      "The 1651 engraving as a diagram: hover or tap each region of the plate — the giant, the landscape, and the ten panels in which every civil instrument faces its ecclesiastical double — to see what it shows.",
  },
  {
    href: "/definitions/",
    title: "The chain of definitions",
    summary:
      "Hobbes builds the book out of one continuous system of definitions, each assembled from terms fixed earlier. Two diagrams trace the dependencies from motion to the common-wealth, and from there to the church.",
  },
  {
    href: "/scripture/",
    title: "Scriptural references",
    summary:
      "Every passage Hobbes cites by chapter and verse, resolved to modern book names and linked to the King James text, with the paragraphs where he uses each one.",
  },
  {
    href: "/latin/",
    title: "Latin glossary",
    summary:
      "The Latin Hobbes keeps in a book written in English on purpose: terms he is defining, the Vulgate corrected against the King James, and the schools' jargon quoted so that it can be convicted in its own words.",
  },
  {
    href: "/greek/",
    title: "Greek glossary",
    summary:
      "More Greek than Latin, doing a different job: the etymologies by which a bishop turns back into an overseer, excommunication into being put out of the meeting, and hell into a valley outside Jerusalem. With the Hebrew at the end.",
  },
  {
    href: "/thinkers/",
    title: "Thinkers named",
    summary:
      "Everyone named as a writer or an authority, grouped as the book uses them, with a closing list of the people a reader expects and does not find.",
  },
  {
    href: "/further-reading/",
    title: "Further reading",
    summary:
      "The editions worth holding, and the books about Leviathan that set the terms everyone else argues in, each described by what it claims rather than by its reputation.",
  },
  {
    href: "/after-hobbes/",
    title: "After Hobbes",
    summary:
      "The works that answer him rather than explain him: Spinoza, Locke, Rousseau and Hume in the first century, and the modern arguments still conducted on his ground.",
  },
  {
    href: "/ancestor/",
    title: "Disciplinary legacy",
    summary:
      "Social science, legal positivism, artificial intelligence, game theory and the rest: the disciplines that trace themselves back to Leviathan, set beside the passages they trace themselves to.",
  },
];
---

<Layout title="Appendix">
  <SectionIndex
    title="Appendix"
    intro="Apparatus rather than argument. The first five are built from the text itself at build time, so they stay in step with the chapters as they are edited; the last three are lists rather than machinery."
    entries={entries}
  />
</Layout>
