---
import Layout from "../layouts/Layout.astro";
import Lightbox from "../components/Lightbox.astro";
// @ts-ignore -- plain-JS rehype helpers, so the footnote's quotation lands on
// the paragraph and is highlighted there, like quotations everywhere else.
import { loadChapters, locate, quoteHref } from "../plugins/rehype-quote-sources.mjs";
import ResumeReading from "../components/ResumeReading.astro";
import frontispiece from "../assets/frontispiece.jpg";

/** The sentence in Chapter 28 where Hobbes explains the book's title. */
const KING_OF_THE_PROUD = "having set forth the great power of Leviathan, called him King of the Proud";
const proud = locate(loadChapters(), KING_OF_THE_PROUD);
const proudHref = proud
  ? quoteHref(proud.chapter.id, proud.para, KING_OF_THE_PROUD)
  : "/chapters/28-of-punishments-and-rewards/";

const alt =
  "The frontispiece of Leviathan, 1651: a crowned giant composed of hundreds of small human figures rises above a landscape, holding a sword in one hand and a bishop's crozier in the other. Below, two columns of small panels show the instruments of civil and ecclesiastical power.";
---

<Layout title="Home">
  <section class="flex flex-col gap-14 md:gap-20">
    <div>
      <p class="eyebrow">
        <a
          href="/hobbes/"
          class="underline decoration-stone-300 underline-offset-4 transition-colors hover:text-stone-900 dark:decoration-stone-600 dark:hover:text-stone-100"
          >Thomas Hobbes</a
        > · 1651
      </p>
      <h1 class="mt-7 font-serif text-6xl leading-none font-semibold tracking-tight md:text-7xl">Leviathan</h1>
      <p class="mt-9 font-serif text-xl leading-snug text-stone-600 italic dark:text-stone-400">
        or The Matter, Forme and Power of a <a
          href="/concepts/commonwealth/"
          class="underline decoration-stone-300 underline-offset-4 transition-colors hover:text-stone-900 dark:decoration-stone-600 dark:hover:text-stone-100"
          >Common-Wealth</a
        > Ecclesiasticall and Civil
      </p>
      <p class="mt-10 text-sm tracking-wide text-stone-500 dark:text-stone-400">
        <span class="font-serif"
          >Non est potestas Super Terram quae Comparetur ei.<sup class="fn-ref"
            ><a id="fnref-1" href="#fn-1">1</a></sup
          ></span
        >
        <a
          href="https://en.wikisource.org/wiki/Bible_(King_James)/Job#Chapter_41"
          target="_blank"
          rel="noopener noreferrer"
          class="external ml-2 text-xs underline decoration-stone-300 underline-offset-2 transition-colors hover:text-stone-900 dark:decoration-stone-600 dark:hover:text-stone-100"
          >Job 41</a
        >
      </p>
      <p class="mt-12 max-w-prose text-base leading-relaxed text-stone-700 dark:text-stone-300">
        A reading edition of the complete 1651 text. Every term Hobbes defines is explained where it occurs
        and every scripture he cites is linked; the chain of definitions is traced from motion to the
        common-wealth, the arguments he answers are set beside the chapters that answer them, and the great
        themes, the man himself, his other nine books, and the two centuries of reply are followed across
        the rest of the site.
      </p>
      <div class="mt-12 flex flex-wrap gap-4">
        <ResumeReading />
        <a
          href="/chapters/the-epistle-dedicatory/"
          class="inline-flex items-center gap-2 rounded bg-stone-900 px-4 py-2 text-sm font-medium text-stone-50 transition-colors hover:bg-stone-700 dark:bg-stone-100 dark:text-stone-900 dark:hover:bg-stone-300"
        >
          <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 5.5C8.6 4.3 6.6 3.8 3 4v11c3.6-.2 5.6.3 7 1.5 1.4-1.2 3.4-1.7 7-1.5V4c-3.6-.2-5.6.3-7 1.5Z" />
            <path d="M10 5.5v11" />
          </svg>
          Start reading
        </a>
        <a
          href="/themes/"
          class="inline-flex items-center gap-2 rounded border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 transition-colors hover:border-stone-500 hover:text-stone-900 dark:border-stone-700 dark:text-stone-300 dark:hover:border-stone-500 dark:hover:text-stone-100"
        >
          <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="10" cy="10" r="7.25" />
            <path d="m13 7-1.8 4.2L7 13l1.8-4.2Z" />
          </svg>
          Explore the themes
        </a>
        <a
          href="/concepts/"
          class="inline-flex items-center gap-2 rounded border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 transition-colors hover:border-stone-500 hover:text-stone-900 dark:border-stone-700 dark:text-stone-300 dark:hover:border-stone-500 dark:hover:text-stone-100"
        >
          <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 5.5h7.5L16.5 10l-5 5H4Z" />
            <path d="M12.6 7.9h.01" />
          </svg>
          Look up a concept
        </a>
        <a
          href="/touchstones/"
          class="inline-flex items-center gap-2 rounded border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 transition-colors hover:border-stone-500 hover:text-stone-900 dark:border-stone-700 dark:text-stone-300 dark:hover:border-stone-500 dark:hover:text-stone-100"
        >
          <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="7.6" cy="7.8" r="2.4" />
            <circle cx="13.4" cy="9" r="1.9" />
            <path d="M3 16.2c.7-2.5 2.3-3.8 4.6-3.8 1.3 0 2.4.4 3.2 1.2" />
            <path d="M11.2 16.2c.4-1.7 1.4-2.6 3-2.6 1.1 0 1.9.4 2.5 1.2" />
          </svg>
          Meet the touchstones
        </a>
        <a
          href="/hobbes/"
          class="inline-flex items-center gap-2 rounded border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 transition-colors hover:border-stone-500 hover:text-stone-900 dark:border-stone-700 dark:text-stone-300 dark:hover:border-stone-500 dark:hover:text-stone-100"
        >
          <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="10" cy="7.2" r="3" />
            <path d="M4.6 16.4c.9-2.9 2.7-4.3 5.4-4.3s4.5 1.4 5.4 4.3" />
          </svg>
          Hobbes himself
        </a>
        <a
          href="/works/"
          class="inline-flex items-center gap-2 rounded border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 transition-colors hover:border-stone-500 hover:text-stone-900 dark:border-stone-700 dark:text-stone-300 dark:hover:border-stone-500 dark:hover:text-stone-100"
        >
          <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4.5h4.5v11H4z" />
            <path d="M9.5 4.5H14v11H9.5z" />
            <path d="M3 17h14" />
          </svg>
          The other works
        </a>
        <a
          href="/appendix/"
          class="inline-flex items-center gap-2 rounded border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 transition-colors hover:border-stone-500 hover:text-stone-900 dark:border-stone-700 dark:text-stone-300 dark:hover:border-stone-500 dark:hover:text-stone-100"
        >
          <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 3.5h7.5L15.5 6.5v10H5z" />
            <path d="M12 3.5v3.2h3.4" />
            <path d="M7.5 10h5.5M7.5 12.8h3.5" />
          </svg>
          Explore supplementary material
        </a>
      </div>
    </div>
    <figure>
      <div>
        <Lightbox
          src={frontispiece}
          widths={[480, 720, 1080]}
          sizes="(min-width: 768px) 42rem, 90vw"
          alt={alt}
          priority
          caption="Frontispiece of Leviathan, engraved by Abraham Bosse in consultation with Hobbes, 1651. British Library copy, via Wikimedia Commons."
          class="w-full rounded border border-stone-200 shadow-[0_24px_48px_-24px_rgb(0_0_0/0.45)] dark:border-stone-800"
        />
      </div>
      <figcaption class="mt-3 text-center text-xs text-stone-500 dark:text-stone-400">
        Engraved by Abraham Bosse, 1651. Click to enlarge.
      </figcaption>
    </figure>
  </section>

  <section class="mt-20">
    <h2 id="about-the-frontispiece" class="section-heading">
      <a href="#about-the-frontispiece" class="heading-anchor">About the frontispiece</a>
    </h2>
    <div class="prose-chapter mt-4 font-serif text-lg leading-relaxed">
      <p>
        The engraving is the argument of the book in a single image. A giant wearing a crown looks out over a
        peaceful landscape: fields, a river, a walled town with its church, a few figures going about their
        business. His body is made of people, hundreds of them, standing close together and facing inward, so
        that the sovereign is nothing but the subjects who compose him. This is the common-wealth as Hobbes
        defines it in <a href="/chapters/17-of-the-causes-generation-and-definition-of-a-common-wealth/" class="chapter-link">Chapter 17</a>: one person, of whose acts a great multitude have made themselves the author.
      </p>
      <p>
        In his right hand he holds a sword, the civil power; in his left, a bishop's crozier, the ecclesiastical
        power. Hobbes's point, argued at length in Parts III and IV, is that both belong to the same hand. The
        two columns of panels beneath repeat the pairing. On the sword's side: a castle, a crown, a cannon, a
        trophy of weapons, and a battle. On the crozier's side: a church, a mitre, a thunderbolt of
        excommunication, the forked distinctions of scholastic logic, and an ecclesiastical court. Each is the
        civil or spiritual counterpart of the other.
      </p>
      <p>
        Across the top runs a line from the Book of Job, chapter 41, where God describes the sea monster
        Leviathan: <em>Non est potestas Super Terram quae Comparetur ei</em>, "There is no power on earth which
        can be compared to him." Hobbes took his title from the same verses. The creature that nothing on earth
        can match is the state, and the picture shows what it is made of.
      </p>
    </div>
    <p class="mt-6 text-xs text-stone-500 dark:text-stone-400">
      British Library copy of the 1651 edition, via Wikimedia Commons. Public domain.
    </p>
    <div class="chapter-footnotes">
      <p class="chapter-footnotes__title" id="notes">Notes</p>
      <ol class="footnotes">
        <li id="fn-1">
          <a href="#fnref-1" class="footnotes__num" aria-label="Back to the text">1</a>
          <span>
            “There is no power on earth to be compared to him.” The motto runs across the top of the
            frontispiece, and is the <a
              class="external"
              href="https://en.wikipedia.org/wiki/Vulgate"
              target="_blank"
              rel="noopener noreferrer">Vulgate</a
            >'s Job 41:24 — the verse numbered 41:33 in the King James
            text Hobbes worked from, where it reads “Upon earth there is not his like, who is made
            without fear.” He takes the comparison up himself at the end of{" "}
            <a href="/chapters/28-of-punishments-and-rewards/" class="chapter-link">Chapter 28</a>, where
            God, “<a href={proudHref} class="chapter-link">having set forth the great power of Leviathan, called
            him King of the Proud</a>.”
          </span>
        </li>
      </ol>
    </div>
  </section>
</Layout>
