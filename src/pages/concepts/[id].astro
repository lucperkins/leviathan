---
import { getCollection, getEntries } from "astro:content";
import EntryPage from "../../theme/components/EntryPage.astro";
import { entryRoutes } from "../../theme/lib/routes";
import { chapterLinks } from "../../lib/related";
import { hobbesForm } from "../../lib/spelling";

export async function getStaticPaths() {
  // Same order as the sidebar: alphabetical by title.
  const concepts = (await getCollection("concepts")).sort((a, b) => a.data.title.localeCompare(b.data.title));
  return entryRoutes(concepts, "/concepts");
}

const { entry, prev, next } = Astro.props;
const chapters = chapterLinks(await getEntries(entry.data.chapters));
---

<EntryPage
  entry={entry}
  kind="Concept"
  meta={hobbesForm(entry.data.title, entry.data.hobbes)}
  related={[{ title: "Read in Leviathan", items: chapters }]}
  prev={prev}
  next={next}
  sequence="concept"
/>
