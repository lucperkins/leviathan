---
import Layout from "../layouts/Layout.astro";
import Shelves from "../components/Shelves.astro";
// @ts-ignore -- plain-JS data, like the other appendix pages
import { CLAIMS, CLAIMS_TOTAL } from "../lib/ancestry.mjs";
---

<Layout title="Disciplinary legacy">
  <header class="mb-8">
    <p class="eyebrow">Appendix</p>
    <h1 class="mt-1 font-serif text-3xl font-semibold">Disciplinary legacy</h1>
    <p class="mt-3 max-w-prose text-lg text-stone-600 dark:text-stone-400">
      {CLAIMS_TOTAL} disciplines that trace themselves back to <em>Leviathan</em>, and the passages they trace
      themselves to. Some of the claims are Hobbes's own — he thought he had invented civil philosophy and said
      so — and some are the work of people who found a sentence of his that fitted. Each entry gives the claim
      and where in the book it rests, so a reader can judge how much of it is in the text. The story of how the
      book was received is <a href="/hobbes/impact/" class="chapter-link">his impact</a>; the arguments made
      against him are <a href="/after-hobbes/" class="chapter-link">after Hobbes</a>.
    </p>
  </header>

  <Shelves shelves={CLAIMS} />
</Layout>
