---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { PARTS, partNumber } from "../lib/parts";

const ROMAN = ["I", "II", "III", "IV"];

const all = (await getCollection("chapters")).sort((a, b) => a.data.number - b.data.number);
const front = all.filter((c) => !c.data.part && c.data.number <= 0);
const back = all.filter((c) => !c.data.part && c.data.number > 0);
const parts = PARTS.map((title) => ({
  title,
  numeral: ROMAN[partNumber(title) - 1],
  chapters: all.filter((c) => c.data.part === title),
})).filter((p) => p.chapters.length);
---

<Layout title="Contents">
  <header class="mb-12 pb-8 text-center">
    <p class="eyebrow">Front matter</p>
    <h1 class="mt-3 font-serif text-4xl font-semibold tracking-tight">Contents</h1>
    <p class="mx-auto mt-4 max-w-xl font-serif text-base leading-snug text-stone-500 italic dark:text-stone-400">
      Leviathan, or The Matter, Forme and Power of a Common-Wealth Ecclesiasticall and Civil
    </p>
    <p class="mt-3 text-xs tracking-wide text-stone-400 dark:text-stone-500">London, 1651</p>
  </header>

  {
    front.length > 0 && (
      <ul class="toc-front mx-auto mb-14 max-w-lg">
        {front.map((c) => (
          <li>
            <a href={`/chapters/${c.id}/`}>{c.data.title}</a>
          </li>
        ))}
      </ul>
    )
  }

  <div class="space-y-14">
    {
      parts.map((part) => (
        <section>
          <header class="toc-part">
            <span class="toc-part__numeral">{part.numeral}</span>
            <h2 class="toc-part__title">{part.title}</h2>
          </header>
          <ol class="toc-list">
            {part.chapters.map((c) => (
              <li>
                <a href={`/chapters/${c.id}/`}>
                  <span class="toc-list__num">{c.data.number}</span>
                  <span class="toc-list__title">{c.data.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>

  {
    back.length > 0 && (
      <ul class="toc-front mx-auto mt-14 max-w-lg pt-10">
        {back.map((c) => (
          <li>
            <a href={`/chapters/${c.id}/`}>{c.data.title}</a>
          </li>
        ))}
      </ul>
    )
  }

  <p class="mt-16 text-center text-xs text-stone-400 dark:text-stone-500">
    <a href="/chapters/the-epistle-dedicatory/" class="hover:text-stone-700 dark:hover:text-stone-300">
      Start reading &rarr;
    </a>
  </p>
</Layout>
