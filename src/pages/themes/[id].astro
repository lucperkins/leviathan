---
import { getCollection, getEntries, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ConceptHeader from "../../components/ConceptHeader.astro";
import PrevNext from "../../components/PrevNext.astro";
import Prose from "../../components/Prose.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import { chapterLinks, conceptLinks } from "../../lib/related";
import { neighbours } from "../../lib/sequence";

export async function getStaticPaths() {
  // Same order as the sidebar: alphabetical by title.
  const themes = (await getCollection("themes")).sort((a, b) => a.data.title.localeCompare(b.data.title));
  return themes.map((theme, i) => ({
    params: { id: theme.id },
    props: {
      theme,
      ...neighbours(themes, i, (t) => ({ href: `/themes/${t.id}/`, title: t.data.title })),
    },
  }));
}

const { theme, prev, next } = Astro.props;
const { Content } = await render(theme);
const chapters = chapterLinks(await getEntries(theme.data.chapters));
const concepts = conceptLinks(await getEntries(theme.data.concepts));
---

<Layout title={theme.data.title}>
  <ConceptHeader kind="Theme" title={theme.data.title} summary={theme.data.summary} />
  <Prose>
    <Content />
  </Prose>
  <RelatedLinks title="Related concepts" items={concepts} />
  <RelatedLinks title="Read in Leviathan" items={chapters} />
  <PrevNext kind="theme" prev={prev} next={next} />
</Layout>
