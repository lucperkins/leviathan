---
import Layout from "../layouts/Layout.astro";
import Glossary from "../components/Glossary.astro";
// @ts-ignore -- plain-JS data, shares the chapter paragraph numbering
import { latinIndex } from "../lib/latin.mjs";

const { groups, total, absent } = latinIndex();
---

<Layout title="Latin glossary">
  <header class="mb-8">
    <p class="eyebrow">Appendix</p>
    <h1 class="mt-1 font-serif text-3xl font-semibold">Latin glossary</h1>
    <p class="mt-3 max-w-prose text-lg text-stone-600 dark:text-stone-400">
      {total} Latin words and phrases Hobbes keeps in a book he wrote in English on purpose, with what they mean
      and the paragraphs where he uses them. He is not showing off. Some are terms he is defining, some are the
      Vulgate corrected against the King James, and the rest are the schools' jargon, quoted so that it can be
      convicted in its own words. His Greek is <a href="/greek/" class="chapter-link">listed separately</a>.
    </p>
  </header>

  <Glossary
    groups={groups}
    absent={absent}
    absentIntro="The three most quoted pieces of Hobbesian Latin. One is in another of his books, one was added seventeen years later, and one is on the picture rather than in the text."
  />

  <section class="mt-16 max-w-prose">
    <h2 id="on-the-glossary" class="section-heading">
      <a href="#on-the-glossary" class="heading-anchor">On the glossary</a>
    </h2>
    <div class="prose-chapter mt-4 font-serif text-lg leading-relaxed">
      <p>
        The entries are located in the chapter text at build time rather than typed out by hand, so a phrase
        listed here is a phrase that is really there, and the paragraph numbers stay correct as the text is
        corrected. Capitalisation follows the 1651 printer, who capitalises Latin about as consistently as he
        capitalises everything else.
      </p>
      <p>
        Greek has a <a href="/greek/">page of its own</a>, because Hobbes uses it differently: the Latin is
        mostly terms of art, and the Greek is mostly etymology.
      </p>
    </div>
  </section>
</Layout>
