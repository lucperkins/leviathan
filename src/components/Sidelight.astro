---
/**
 * A sidelight: a modern rhyme with the text, boxed so it reads as an aside
 * set beside the argument rather than a section of it. The register is kept
 * for resemblances, not descents — nobody in a sidelight is claimed to have
 * read Hobbes; the claimed descents live on /ancestor/. Used from content
 * MDX, with the prose in the slot.
 */
interface Props {
  title: string;
}
const { title } = Astro.props;
const id = "sidelight-" + title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
---

<aside class="sidelight" aria-labelledby={id}>
  <p class="sidelight__label">
    {/* A small light throwing its rays from one side, drawn in the sidebar icons' idiom. */}
    <svg aria-hidden="true" viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
      <circle cx="6" cy="8" r="3.2" />
      <path d="M10 4.7 11.7 3.2M11.2 8h2.2M10 11.3l1.7 1.5" />
    </svg>
    Sidelight
  </p>
  <h3 id={id} class="sidelight__title">
    <a href={`#${id}`} class="heading-anchor">{title}</a>
  </h3>
  <div class="sidelight__body">
    <slot />
  </div>
</aside>
