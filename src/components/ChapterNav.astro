---
import ChapterNavItem from "./ChapterNavItem.astro";
import NavSection from "./NavSection.astro";
import { partLabel, partNumber } from "../lib/parts";

export interface NavChapter {
  id: string;
  number: number;
  title: string;
  /** Absent for front matter (number ≤ 0, listed before the parts) and back matter (listed after). */
  part?: string;
}

interface Props {
  chapters: NavChapter[];
  currentPath?: string;
}
const { chapters, currentPath } = Astro.props;

const sorted = [...chapters].sort((a, b) => a.number - b.number);
const front = sorted.filter((ch) => !ch.part && ch.number <= 0);
const back = sorted.filter((ch) => !ch.part && ch.number > 0);
const parts = new Map<string, NavChapter[]>();
for (const ch of sorted) {
  if (ch.part) parts.set(ch.part, [...(parts.get(ch.part) ?? []), ch]);
}
// Parts in the book's order, not first-seen order.
const ordered = [...parts].sort(([a], [b]) => partNumber(a) - partNumber(b));
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const isActive = (ch: NavChapter) => currentPath === `/chapters/${ch.id}/`;
---

<nav aria-label="The book" class="text-sm">
  <NavSection id="book" title="The book">
    <ul class="mb-2 ml-2 space-y-1">
      <ChapterNavItem
        chapter={{ id: "contents", number: 0, title: "Contents" }}
        href="/contents/"
        active={currentPath === "/contents/"}
      />
    </ul>
    {
      front.length > 0 && (
        <ul class="mb-2 ml-2 space-y-1">
          {front.map((ch) => (
            <ChapterNavItem chapter={ch} active={isActive(ch)} />
          ))}
        </ul>
      )
    }
    {
      ordered.map(([part, list]) => (
        <NavSection id={`part-${slug(part)}`} title={partLabel(part)} nested>
          <ul class="space-y-1">
            {list.map((ch) => (
              <ChapterNavItem chapter={ch} active={isActive(ch)} />
            ))}
          </ul>
        </NavSection>
      ))
    }
    {
      back.length > 0 && (
        <ul class="mt-2 ml-2 space-y-1">
          {back.map((ch) => (
            <ChapterNavItem chapter={ch} active={isActive(ch)} />
          ))}
        </ul>
      )
    }
  </NavSection>
</nav>
