---
/**
 * Landing page for a section of the site: a short account of what the section
 * is, then every entry in it with its summary, in the same order as the
 * sidebar. Nothing here sets its own measure: the intro and the entries both
 * fill the reading column, so a section landing page is the same width as the
 * pages it lists. Takes plain data so it renders in Storybook.
 */
import { inlineMarkdown } from "../lib/inline";

export interface IndexEntry {
  href: string;
  title: string;
  /** Small line under the title: a touchstone's dates, a book's title and year, Hobbes's spelling of a theme. */
  meta?: string;
  summary: string;
}

interface Props {
  title: string;
  intro: string;
  entries: IndexEntry[];
  /** Small label above the title. */
  eyebrow?: string;
}
const { title, intro, entries, eyebrow } = Astro.props;
---

<header class="mb-10">
  {
    eyebrow && (
      <p class="eyebrow">{eyebrow}</p>
    )
  }
  <h1 class="mt-1 font-serif text-3xl font-semibold">{title}</h1>
  <p class="mt-3 text-lg text-stone-600 dark:text-stone-400" set:html={inlineMarkdown(intro)} />
</header>

<ul class="section-index">
  {
    entries.map((entry) => (
      <li>
        <a class="section-index__link" href={entry.href}>
          <span class="section-index__title">{entry.title}</span>
          {entry.meta && <span class="section-index__meta">{entry.meta}</span>}
        </a>
        <p class="section-index__summary" set:html={inlineMarkdown(entry.summary)} />
      </li>
    ))
  }
</ul>
