---
/**
 * An image that opens full-size in a dismissable modal (native <dialog>,
 * driven by the Alpine `lightbox` component): click to open; Escape, the
 * close button, or a click on the backdrop closes it.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
}
const { src, alt, widths = [480, 720, 1080], sizes = "(min-width: 1024px) 42rem, 100vw", class: className } = Astro.props;
---

<div x-data="lightbox">
  <button type="button" x-on:click="open()" class="block w-full cursor-zoom-in" title="View full size">
    <Image src={src} widths={widths} sizes={sizes} alt={alt} class={className} />
  </button>
  <dialog
    x-ref="dialog"
    x-on:click="if ($event.target === $refs.dialog) close()"
    x-on:close="closed()"
    class="lightbox m-auto max-h-[calc(100vh-3rem)] max-w-[calc(100vw-3rem)] overflow-hidden rounded bg-transparent p-0 backdrop:bg-stone-950/85"
    aria-label={alt}
  >
    <img src={src.src} alt={alt} class="block max-h-[calc(100vh-3rem)] max-w-[calc(100vw-3rem)] object-contain" />
    <button
      type="button"
      x-on:click="close()"
      aria-label="Close"
      class="absolute top-2 right-2 rounded-full bg-stone-950/70 p-2 text-stone-100 transition-colors hover:bg-stone-950"
    >
      <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 4l8 8M12 4l-8 8" /></svg>
    </button>
  </dialog>
</div>
