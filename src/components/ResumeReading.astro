---
/**
 * A link back to wherever the reader left off, driven by the Alpine
 * `resumeReading` component. There is no server-side session, so the button
 * starts hidden and appears only once Alpine has found a position in
 * localStorage; readers who have not opened a chapter never see it.
 */
---

<a
  x-data="resumeReading"
  x-show="saved"
  x-bind:href="href"
  href="/chapters/the-epistle-dedicatory/"
  style="display: none"
  class="inline-flex items-center gap-1.5 rounded border border-stone-300 px-3 py-1.5 text-xs font-medium text-stone-700 md:gap-2 md:px-4 md:py-2 md:text-sm transition-colors hover:border-stone-500 hover:text-stone-900 dark:border-stone-700 dark:text-stone-300 dark:hover:border-stone-500 dark:hover:text-stone-100"
>
  <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 3.5h8v13l-4-3.2-4 3.2Z" />
  </svg>
  <span x-text="label">Resume reading</span>
</a>
