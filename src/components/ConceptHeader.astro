---
import { inlineMarkdown } from "../lib/inline";

interface Props {
  title: string;
  summary: string;
  /** Small label above the title, e.g. "Concept" or "Touchstone". */
  kind?: string;
  /** Optional line under the title, e.g. an touchstone's dates. */
  meta?: string;
}
const { title, summary, kind = "Concept", meta } = Astro.props;
---

<header class="mb-8">
  <p class="eyebrow">{kind}</p>
  <h1 class="mt-1 font-serif text-3xl font-semibold">{title}</h1>
  {meta && <p class="mt-1 text-sm text-stone-500 dark:text-stone-400">{meta}</p>}
  <p class="mt-3 text-lg text-stone-600 dark:text-stone-400 summary" set:html={inlineMarkdown(summary)} />
</header>
