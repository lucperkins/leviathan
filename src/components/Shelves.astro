---
/**
 * A shelved list of books: section navigation, then each shelf with its
 * entries. Used by /further-reading/ and /after-hobbes/, which hold different
 * lists in the same shape. An entry links the book itself where it has an
 * entry of its own, and otherwise puts the link on the author. The year sits
 * on the right of the title, where the mention counts sit on /thinkers/, and
 * the author goes on its own line beneath it.
 */
import { inlineMarkdown } from "../lib/inline";

interface Work {
  id: string;
  title: string;
  href?: string;
  author: string;
  authorHref?: string;
  year: string;
  note: string;
}
interface Shelf {
  title: string;
  blurb: string;
  works: Work[];
}
interface Props {
  shelves: Shelf[];
}
const { shelves } = Astro.props;
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const external = (href?: string) => Boolean(href?.startsWith("http"));
---

<nav aria-label="Sections" class="mb-10 flex items-start gap-3">
  <svg
    aria-hidden="true"
    viewBox="0 0 16 16"
    width="14"
    height="14"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    class="mt-1 shrink-0 text-stone-400 dark:text-stone-600"
  >
    <path d="M2.5 4h.01M2.5 8h.01M2.5 12h.01" />
    <path d="M6 4h7.5M6 8h7.5M6 12h5" />
  </svg>
  <ul class="space-y-1 text-sm">
    {
      shelves.map((s) => (
        <li>
          <a
            href={`#${slug(s.title)}`}
            class="text-stone-600 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100"
          >
            {s.title}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<div class="space-y-12">
  {
    shelves.map((s) => (
      <section>
        <h2
          id={slug(s.title)}
          class="section-heading"
        >
          <a href={`#${slug(s.title)}`} class="heading-anchor">
            {s.title}
          </a>
        </h2>
        <p class="mt-2 max-w-prose text-sm text-stone-500 dark:text-stone-400">{s.blurb}</p>
        <ul class="mt-5 space-y-5">
          {s.works.map((w) => (
            <li class="thinker" id={w.id}>
              <p class="thinker__head">
                <span class="thinker__name">
                  {w.href ? (
                    <a
                      class={external(w.href) ? "external" : undefined}
                      href={w.href}
                      target={external(w.href) ? "_blank" : undefined}
                      rel={external(w.href) ? "noopener noreferrer" : undefined}
                    >
                      {w.title}
                    </a>
                  ) : (
                    w.title
                  )}
                </span>
                <span class="thinker__count">{w.year}</span>
              </p>
              <p class="work__author">
                {w.authorHref ? (
                  <a class="external" href={w.authorHref} target="_blank" rel="noopener noreferrer">
                    {w.author}
                  </a>
                ) : (
                  w.author
                )}
              </p>
              <p class="thinker__note" set:html={inlineMarkdown(w.note)} />
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
