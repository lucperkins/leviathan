---
/**
 * The site's mark: a crown over a crossed sword and crozier, the civil and
 * ecclesiastical powers the frontispiece puts in one pair of hands. Same paths
 * as `public/favicon.svg`, with the dark tile dropped and everything drawn in
 * `currentColor`, so it takes the page's colour instead of carrying its own
 * background into a light or sepia one.
 *
 * The sword ends in a pommel rather than a crossguard. A guard would have to be
 * perpendicular to a blade already at 45 degrees, which puts a second X beneath
 * the first and turns to mush at favicon size; the disc says which end is held
 * without adding a crossing, and the crozier's curl says the same of the other.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 44, class: className } = Astro.props;
---

<svg
  aria-hidden="true"
  viewBox="0 0 32 32"
  width={size}
  height={size}
  fill="none"
  class={className}
>
  <path d="M7 11.5 8.5 5l4.5 4.2L16 4l3 5.2L23.5 5 25 11.5Z" fill="currentColor" />
  <g stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M11 26.5 22 15.5" />
    <path d="M22.5 28 10 15.5" />
    <path d="M10 15.5c-2.8-2.8-1.2-6.6 2-5.4" />
  </g>
  <circle cx="9.6" cy="27.9" r="1.9" fill="currentColor" />
</svg>
