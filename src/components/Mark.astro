---
/**
 * The site's mark: a crown over a crossed sword and scepter, after the two
 * powers the 1651 frontispiece puts in one pair of hands. Same paths as
 * `public/favicon.svg`, with the dark tile dropped and everything drawn in
 * `currentColor`, so it takes the page's colour instead of carrying its own
 * background into a light or sepia one.
 *
 * The two staves are exact mirrors across the centre line, so they read as the
 * same length; the scepter runs up-left and is capped by the orb, the sword
 * runs up-right with a crossguard down by the handle end, well clear of the crossing, and the crown sits clear
 * above both.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 44, class: className } = Astro.props;
---

<svg
  aria-hidden="true"
  viewBox="0 0 32 32"
  width={size}
  height={size}
  fill="none"
  class={className}
>
  <path d="M7 10 8.5 3.5l4.5 4.2L16 2.5l3 5.2L23.5 3.5 25 10Z" fill="currentColor" />
  <g stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 29 9 14.2" />
    <path d="M11 29 23 14.2" />
    <path d="M11.3 26 13.9 28.2" />
  </g>
  <circle cx="9" cy="14.2" r="1.9" fill="currentColor" />
</svg>
