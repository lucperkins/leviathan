---
/**
 * The site's mark: a crown over a crossed sword and scepter, after the two
 * powers the 1651 frontispiece puts in one pair of hands. Same figure as
 * `public/favicon.svg`, drawn in `currentColor` with the dark tile dropped.
 *
 * The viewBox hugs the ink — x 7–25, y 2.5–30.1 of the favicon's square, the
 * crown's corners and the staves' stroke caps — so the rendered box IS the
 * figure and callers can align its edges like any other box, with no dead
 * margin to compensate for. `size` is the height; the width follows from the
 * figure's own proportions.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 44, class: className } = Astro.props;
const width = +((size * 18) / 27.6).toFixed(1);
---

<svg
  aria-hidden="true"
  viewBox="7 2.5 18 27.6"
  width={width}
  height={size}
  fill="none"
  class={className}
>
  <path d="M7 10 8.5 3.5l4.5 4.2L16 2.5l3 5.2L23.5 3.5 25 10Z" fill="currentColor" />
  <g stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 29 9 14.2" />
    <path d="M11 29 23 14.2" />
    <path d="M11.3 26 13.9 28.2" />
  </g>
  <circle cx="9" cy="14.2" r="1.9" fill="currentColor" />
</svg>
