---
interface Props {
  number: number;
  title: string;
  /** Absent for front matter (number ≤ 0) and back matter, which get no chapter number. */
  part?: string;
}
const { number, title, part } = Astro.props;
const eyebrow = part ? `Chapter ${number}` : number <= 0 ? "Front matter" : "Back matter";
---

<header class="mb-8">
  <p class="eyebrow">
    {eyebrow}
  </p>
  <h1 class="mt-1 font-serif text-3xl font-semibold">{title}</h1>
</header>
