---
/** One entry in the sidebar's book list. Front and back matter (no `part`) show no number. */
import type { NavChapter } from "./ChapterNav.astro";

interface Props {
  chapter: NavChapter;
  active?: boolean;
  /** Overrides the chapter URL, for entries that are not chapters. */
  href?: string;
}
const { chapter, active = false, href: hrefProp } = Astro.props;
const href = hrefProp ?? `/chapters/${chapter.id}/`;
---

<li>
  <a
    href={href}
    aria-current={active ? "page" : undefined}
    class:list={[
      "flex gap-2 rounded py-1 pr-3 pl-3 leading-snug transition-colors",
      active
        ? "bg-stone-800 text-stone-50 dark:bg-stone-100 dark:text-stone-900"
        : "text-stone-700 hover:bg-stone-200 dark:text-stone-300 dark:hover:bg-stone-800",
    ]}
  >
    {
      chapter.part && (
        <span class="w-6 shrink-0 text-right tabular-nums text-stone-400 dark:text-stone-500">{`${chapter.number}.`}</span>
      )
    }
    <span>{chapter.title}</span>
  </a>
</li>
