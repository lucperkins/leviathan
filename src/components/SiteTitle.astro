---
/**
 * The sidebar masthead. The mark shares the title's line: one flex row,
 * vertically centred, with the author line beneath — so the mark's place
 * comes from the layout, not from margin nudges. Its viewBox hugs its ink,
 * so the right edge that aligns with the nav rows is the crown's own corner.
 * Decorative, and hidden from assistive technology: the words say the same
 * thing.
 */
import Mark from "./Mark.astro";

interface Props {
  href?: string;
}
const { href = "/" } = Astro.props;
---

<a href={href} class="block">
  <span class="flex items-center justify-between gap-3">
    <span class="font-serif text-2xl font-semibold tracking-tight">Leviathan</span>
    <Mark size={28} class="shrink-0 text-stone-400 dark:text-stone-500" />
  </span>
  <span class="block text-xs text-stone-500 dark:text-stone-400">Thomas Hobbes, 1651</span>
</a>
