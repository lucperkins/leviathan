---
import "../styles/global.css";
import { getCollection } from "astro:content";
import BackButton from "../components/BackButton.astro";
import ChapterNav from "../components/ChapterNav.astro";
import ListNav from "../components/ListNav.astro";
import SiteTitle from "../components/SiteTitle.astro";
import { interlocutorSortKey } from "../lib/related";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title: string;
  /** Wider content column (used by the home page hero). */
  wide?: boolean;
}
const { title, wide = false } = Astro.props;

const isHome = Astro.url.pathname === "/";
const currentPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

const chapters = (await getCollection("chapters")).map((ch) => ({ id: ch.id, ...ch.data }));
const concepts = (await getCollection("concepts")).map((c) => ({ id: c.id, title: c.data.title }));
const interlocutors = (await getCollection("interlocutors")).map((a) => ({ id: a.id, title: a.data.title, sort: interlocutorSortKey(a) }));
const themes = (await getCollection("themes")).map((t) => ({ id: t.id, title: t.data.title }));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title} · Leviathan</title>
    {/* Pre-paint: apply the persisted theme (or system preference) so there is no flash. Alpine `theme` owns it after boot. */}
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = JSON.parse(localStorage.getItem("leviathan:theme") || "null");
        } catch {}
        const dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-900 dark:bg-stone-950 dark:text-stone-100">
    <div class="flex min-h-screen">
      <aside
        class="sticky top-0 flex h-screen w-80 shrink-0 flex-col border-r border-stone-200 bg-stone-100 dark:border-stone-800 dark:bg-stone-900"
      >
        <div class="flex-1 overflow-y-auto px-4 py-6" data-nav-scroll x-data="navScroll" x-on:scroll.passive="save()">
          <div class="mb-8"><SiteTitle /></div>
          <ChapterNav chapters={chapters} currentPath={currentPath} />
          {/* The rule splits the book section's bottom margin so the gap to Themes equals the gaps below it. */}
          <div class="-mt-2 border-t border-stone-200 pt-2 dark:border-stone-800">
            <ListNav sectionId="themes" title="Themes" basePath="/themes" items={themes} currentPath={currentPath} />
            <ListNav sectionId="concepts" title="Concepts" basePath="/concepts" items={concepts} currentPath={currentPath} />
            <ListNav sectionId="interlocutors" title="Interlocutors" basePath="/interlocutors" items={interlocutors} currentPath={currentPath} />
          </div>
        </div>
        <div class="border-t border-stone-200 px-4 py-3 dark:border-stone-800">
          <ThemeToggle />
        </div>

        {/* Pre-paint only: apply the accordion state Alpine's $persist stored, then the sidebar's
            last scroll offset, so neither jumps after load. Alpine owns both after boot. */}
        <script is:inline>
          for (const el of document.querySelectorAll("details[data-nav-section]")) {
            if (el.querySelector('[aria-current="page"]')) continue;
            try {
              const v = localStorage.getItem(`leviathan:nav:${el.dataset.navSection}`);
              if (v !== null) el.open = JSON.parse(v);
            } catch {}
          }
          try {
            const nav = document.querySelector("[data-nav-scroll]");
            const y = Number(sessionStorage.getItem("leviathan:nav-scroll"));
            if (nav && y > 0) nav.scrollTop = y;
          } catch {}
        </script>
      </aside>
      <main class="flex-1 px-12 pt-12 pb-32">
        <div class:list={["mx-auto", wide ? "max-w-5xl" : "max-w-2xl"]}>
          {!isHome && <BackButton />}
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
