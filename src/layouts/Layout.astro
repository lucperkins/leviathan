---
import "../styles/global.css";
import { getCollection } from "astro:content";
import BackButton from "../components/BackButton.astro";
import ChapterNav from "../components/ChapterNav.astro";
import ListNav from "../components/ListNav.astro";
import SiteTitle from "../components/SiteTitle.astro";
import { touchstoneSortKey, titleSortKey } from "../lib/related";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title: string;
  /** Wider content column (used by the home page hero). */
  wide?: boolean;
}
const { title, wide = false } = Astro.props;

const isHome = Astro.url.pathname === "/";
const currentPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

const chapters = (await getCollection("chapters")).map((ch) => ({ id: ch.id, ...ch.data }));
const concepts = (await getCollection("concepts")).map((c) => ({ id: c.id, title: c.data.title }));
const touchstones = (await getCollection("touchstones")).map((a) => ({ id: a.id, title: a.data.title, sort: touchstoneSortKey(a) }));
const themes = (await getCollection("themes")).map((t) => ({ id: t.id, title: t.data.title, sort: titleSortKey(t.data.title) }));
const hobbes = (await getCollection("hobbes")).map((h) => ({ id: h.id, title: h.data.title, sort: String(h.data.order) }));
const works = (await getCollection("works")).map((w) => ({ id: w.id, title: w.data.title, sort: String(w.data.year) }));
const kindred = (await getCollection("kindred")).map((k) => ({ id: k.id, title: k.data.title, sort: String(k.data.year + 1000).padStart(5, "0") }));

/** Editorial apparatus rather than a content collection. */
const appendix = [
  { id: "definitions", title: "The chain of definitions" },
  { id: "scripture", title: "Scriptural references" },
  { id: "thinkers", title: "Thinkers named" },
  { id: "further-reading", title: "Further reading" },
  { id: "after-hobbes", title: "After Hobbes" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title} · Leviathan</title>
    {/* Pre-paint: apply the persisted theme (or system preference) so there is no flash. Alpine `theme` owns it after boot. */}
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = JSON.parse(localStorage.getItem("leviathan:theme") || "null");
        } catch {}
        const mode = stored ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.classList.toggle("dark", mode === "dark");
        document.documentElement.classList.toggle("theme-sepia", mode === "sepia");
      })();
    </script>
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-900 dark:bg-stone-950 dark:text-stone-100">
    <div class="flex min-h-screen">
      <aside
        class="sticky top-0 flex h-screen w-80 shrink-0 flex-col border-r border-stone-200 bg-stone-100 dark:border-stone-800 dark:bg-stone-900"
      >
        <div class="flex-1 overflow-y-auto px-4 py-6" data-nav-scroll x-data="navScroll" x-on:scroll.passive="save()">
          <div class="mb-8"><SiteTitle /></div>
          <ChapterNav chapters={chapters} currentPath={currentPath} />
          {/* The rule splits the book section's bottom margin so the gap to Themes equals the gaps below it. */}
          <div class="-mt-2 border-t border-stone-200 pt-2 dark:border-stone-800">
            <ListNav sectionId="themes" title="Themes" basePath="/themes" items={themes} currentPath={currentPath} indexHref="/themes/" indexTitle="Overview" />
            <ListNav sectionId="concepts" title="Concepts" basePath="/concepts" items={concepts} currentPath={currentPath} indexHref="/concepts/" indexTitle="Overview" />
            <ListNav sectionId="touchstones" title="Touchstones" basePath="/touchstones" items={touchstones} currentPath={currentPath} indexHref="/touchstones/" indexTitle="Overview" />
            <ListNav sectionId="kindred" title="Kindred spirits" basePath="/kindred" items={kindred} currentPath={currentPath} indexHref="/kindred/" indexTitle="Overview" />
            <ListNav sectionId="hobbes" title="Hobbes himself" basePath="/hobbes" items={hobbes} currentPath={currentPath} indexHref="/hobbes/" indexTitle="Overview" />
            <ListNav sectionId="works" title="Other works" basePath="/works" items={works} currentPath={currentPath} indexHref="/works/" indexTitle="Overview" />
            <ListNav sectionId="appendix" title="Appendix" basePath="" items={appendix} currentPath={currentPath} indexHref="/appendix/" indexTitle="Overview" />
          </div>
        </div>
        <div class="border-t border-stone-200 px-4 py-3 dark:border-stone-800">
          <ThemeToggle />
        </div>

        {/* Pre-paint only: apply the accordion state Alpine's $persist stored, then the sidebar's
            last scroll offset, so neither jumps after load. Alpine owns both after boot. */}
        <script is:inline>
          for (const el of document.querySelectorAll("details[data-nav-section]")) {
            if (el.querySelector('[aria-current="page"]')) continue;
            try {
              const v = localStorage.getItem(`leviathan:nav:${el.dataset.navSection}`);
              if (v !== null) el.open = JSON.parse(v);
            } catch {}
          }
          try {
            const nav = document.querySelector("[data-nav-scroll]");
            const y = Number(sessionStorage.getItem("leviathan:nav-scroll"));
            if (nav && y > 0) nav.scrollTop = y;
          } catch {}
        </script>
      </aside>
      <main class="flex-1 px-12 pt-12 pb-32">
        <div class:list={["mx-auto", wide ? "max-w-5xl" : "max-w-2xl"]}>
          {!isHome && <BackButton />}
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
